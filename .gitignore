# Google-style .gitignore for personal project

# --- OS generated files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editor settings ---
.vscode/
.idea/
*.swp
*.swo

# --- Project specific files ---
# Since this is a personal note-taking project, ignore temp/backup files
*.tmp
*.bak
*~
*.log

# --- Build and local environment (if applicable) ---
dist/
build/
venv/
env/
__pycache__/

# --- Security (Important: Never commit secrets) ---
.env
secret.key